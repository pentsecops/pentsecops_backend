    {
      "name": "Authentication APIs",
      "item": [
        {
          "name": "Admin Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('admin_token', jsonData.data.token);",
                  "    pm.environment.set('admin_id', jsonData.data.admin_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pentsecops.com\",\n  \"password\": \"SecureAdminPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "register"]

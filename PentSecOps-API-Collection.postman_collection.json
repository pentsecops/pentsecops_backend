    {
      "name": "Forgot Password Management",
      "item": [
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pentester@pentsecops.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "forgot-password"
              ]
            },
            "description": "Submit a forgot password request (no authentication required). User submits their email and request escalates to admin for approval."
          },
          "response": []
        },
        {
          "name": "Get Pending Password Reset Requests (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/forgot-password-requests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "forgot-password-requests"
              ]
            },
            "description": "Get all pending password reset requests (admin only). Returns list of all users waiting for admin approval."
          },
          "response": []
        },
        {
          "name": "Approve/Reject Password Reset Request (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/forgot-password-request/{{request_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "forgot-password-request",
                "{{request_id}}"
              ]
            },
            "description": "Approve or reject a password reset request (admin only). Set status to 'accepted' to approve (generates new password and sends email) or 'rejected' to reject. Replace {{request_id}} with the request ID from pending list."
          },
          "response": []
        }
      ],
      "description": "Forgot password management endpoints with admin approval workflow"
    },
    {
      "name": "AI Chat APIs",
      "item": [
        {
          "name": "Process Chat (Send Query to AI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is penetration testing?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/chats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "chats"
              ]
            },
            "description": "Send a query to the AI chat service. The system will send the query to Groq API and return the AI-generated response. Available for all authenticated users (admin, pentester, stakeholder)."
          },
          "response": []
        },
        {
          "name": "Get Conversation History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chats/history?limit=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "chats",
                "history"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Optional: Maximum number of messages to retrieve (default: 50, max: 100)"
                }
              ]
            },
            "description": "Retrieve the conversation history for the authenticated user. Messages are ordered by creation time (most recent first). Optional limit parameter controls how many messages to retrieve."
          },
          "response": []
        },
        {
          "name": "Clear Conversation History",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chats/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "chats",
                "history"
              ]
            },
            "description": "Delete all chat messages for the authenticated user. This action is irreversible."
          },
          "response": []
        }
      ],
      "description": "AI Chat integration with Groq API. Send queries and receive AI-generated responses. Available for all authenticated user roles."
    },

    {
      "name": "WebSocket - Real-time Messaging",
      "item": [
        {
          "name": "WebSocket Connection with Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "ws://{{host}}/ws?token={{userToken}}",
              "protocol": "ws",
              "host": ["{{host}}"],
              "path": ["ws"],
              "query": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "description": "PASETO bearer token for authentication"
                }
              ]
            },
            "description": "Establish WebSocket connection for real-time messaging and notifications. Use the token parameter instead of Authorization header for WebSocket."
          }
        },
        {
          "name": "WebSocket Connection with User ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "ws://{{host}}/ws?user_id={{userId}}",
              "protocol": "ws",
              "host": ["{{host}}"],
              "path": ["ws"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{userId}}",
                  "description": "User ID for authenticated connection"
                }
              ]
            },
            "description": "Establish WebSocket connection using user ID (requires prior authentication)"
          }
        }
      ]
    },
